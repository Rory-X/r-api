# Meta API Hub - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# Required: a unique 32+ byte secret for encrypted account credentials. Keep it stable across restarts.
ACCOUNT_CREDENTIAL_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# First startup requires AUTH_TOKEN or AUTH_TOKEN_HASH. AUTH_TOKEN may be removed after bootstrap.
AUTH_TOKEN=change-me-admin-token
AUTH_TOKEN_HASH=

# Public showcase deployments only. Keeps the management UI read-only and disables proxy traffic/background workers.
DEMO_MODE=false

PORT=4000
NOTIFY_COOLDOWN_SEC=300
ADMIN_IP_ALLOWLIST=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_USE_SYSTEM_PROXY=false
SYSTEM_PROXY_URL=
TZ=Asia/Shanghai

# Auto check-in cron (default: 8:00 AM every day)
CHECKIN_CRON=0 8 * * *

# Balance refresh cron (default: every hour)
BALANCE_REFRESH_CRON=0 * * * *
