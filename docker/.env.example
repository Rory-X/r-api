# Meta API Hub - Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# Admin authentication token (required, change this!)
AUTH_TOKEN=change-me-admin-token

# Public showcase deployments only. Keeps the management UI read-only and disables proxy traffic/background workers.
DEMO_MODE=false

PORT=4000
NOTIFY_COOLDOWN_SEC=300
ADMIN_IP_ALLOWLIST=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Auto check-in cron (default: 8:00 AM every day)
CHECKIN_CRON=0 8 * * *

# Balance refresh cron (default: every hour)
BALANCE_REFRESH_CRON=0 * * * *
