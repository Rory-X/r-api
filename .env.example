# Required in production: generate a unique 32+ byte random secret, keep it out of git, and do not reuse the administrator credential.
ACCOUNT_CREDENTIAL_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
# First startup requires AUTH_TOKEN or AUTH_TOKEN_HASH. AUTH_TOKEN can be removed after the database stores its Argon2id hash.
AUTH_TOKEN=REPLACE_WITH_STRONG_ADMIN_CREDENTIAL
# Advanced alternative: an encoded Argon2id bootstrap hash takes precedence over AUTH_TOKEN.
AUTH_TOKEN_HASH=
ADMIN_SESSION_TTL_MS=43200000
ADMIN_SESSION_TOUCH_INTERVAL_MS=300000
# Enable when TLS terminates in front of Metapi and forwarded protocol headers are unavailable.
ADMIN_COOKIE_SECURE=false
# Keep false for direct access. Behind a reverse proxy, set a trusted proxy IP/CIDR list instead of blindly trusting all clients.
TRUST_PROXY=false
CHECKIN_CRON=0 8 * * *
CHECKIN_SCHEDULE_MODE=cron
CHECKIN_INTERVAL_HOURS=6
CHECKIN_TIME_ZONE=Asia/Shanghai
CHECKIN_WINDOW_START=08:00
CHECKIN_WINDOW_END=10:00
CHECKIN_JITTER_MINUTES=15
CHECKIN_CATCH_UP=true
BALANCE_REFRESH_CRON=0 * * * *
# Optional OAuth overrides. Fill the matching credentials when an override is enabled; Claude requires a client secret with no fallback.
CLAUDE_CLIENT_ID=
CLAUDE_CLIENT_SECRET=
# Codex OAuth override only needs CODEX_CLIENT_ID.
CODEX_CLIENT_ID=
# Gemini CLI override requires both GEMINI_CLI_CLIENT_ID and GEMINI_CLI_CLIENT_SECRET together.
GEMINI_CLI_CLIENT_ID=
GEMINI_CLI_CLIENT_SECRET=
SYSTEM_PROXY_URL=
# Reuse upstream connections for streaming relay traffic. Disable HTTP/2 only for incompatible gateways.
UPSTREAM_HTTP2_ENABLED=true
UPSTREAM_HTTP_CONNECTIONS_PER_ORIGIN=100
UPSTREAM_HTTP_KEEP_ALIVE_TIMEOUT_MS=90000
UPSTREAM_HTTP_KEEP_ALIVE_MAX_TIMEOUT_MS=600000
UPSTREAM_HTTP_AUTO_SELECT_FAMILY=true
UPSTREAM_HTTP_AUTO_SELECT_FAMILY_ATTEMPT_TIMEOUT_MS=250
# Historical first-byte latency softly downweights slow upstreams after enough real-request samples.
FIRST_BYTE_ROUTING_ENABLED=true
FIRST_BYTE_ROUTING_BASELINE_MS=2500
FIRST_BYTE_ROUTING_PENALTY_WINDOW_MS=10000
FIRST_BYTE_ROUTING_MAX_PENALTY_RATIO=0.65
FIRST_BYTE_ROUTING_MIN_SAMPLES=5
WEBHOOK_URL=
BARK_URL=
SERVERCHAN_KEY=
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MODEL_AVAILABILITY_PROBE_CONCURRENCY=1
MODEL_AVAILABILITY_PROBE_ENABLED=false
MODEL_AVAILABILITY_PROBE_INTERVAL_MS=1800000
MODEL_AVAILABILITY_PROBE_TIMEOUT_MS=15000
# Sends real inference requests to recover cooling/active channels. Keep disabled unless every upstream explicitly permits probes.
CHANNEL_RECOVERY_PROBE_ENABLED=false
PORT=4000
DATA_DIR=./data
NOTIFY_COOLDOWN_SEC=300
ADMIN_IP_ALLOWLIST=
TZ=Asia/Shanghai
